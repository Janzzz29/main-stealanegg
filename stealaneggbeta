-- Steal Egg Engine
local function StealEgg(eggObject)
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = char:FindFirstChild("HumanoidRootPart")

    if not hrp then return end

    local returnPosition = savedCFrame or hrp.CFrame

    local targetCFrame
    if eggObject:IsA("BasePart") then
        targetCFrame = eggObject.CFrame
    elseif eggObject:IsA("Model") then
        targetCFrame = eggObject:GetPivot()
    end

    if targetCFrame then
        hrp.CFrame = targetCFrame + Vector3.new(0, 3, 0)
        task.wait(0.3)
        hrp.CFrame = returnPosition

        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Egg Stolen!";
            Text = "Nakuha ang " .. eggObject.Name .. " at nakabalik sa Safe Position!";
            Duration = 3;
        })
    end
end

-- Scan Eggs Function
local function ScanEggs()
    for _, child in pairs(EggList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local foundCount = 0

    for _, obj in pairs(workspace:GetDescendants()) do
        if string.find(string.lower(obj.Name), "egg") then
            if obj:IsA("BasePart") or obj:IsA("Model") then
                foundCount = foundCount + 1

                local Btn = Instance.new("TextButton")
                Btn.Parent = EggList
                Btn.BackgroundColor3 = Color3.fromRGB(35, 35, 50)
                Btn.Size = UDim2.new(0.96, 0, 0, 34)
                Btn.Font = Enum.Font.GothamMedium
                Btn.Text = " 🥚 " .. obj.Name
                Btn.TextColor3 = Color3.fromRGB(240, 240, 255)
                Btn.TextSize = 12
                Btn.TextXAlignment = Enum.TextXAlignment.Left

                local BtnCorner = Instance.new("UICorner")
                BtnCorner.CornerRadius = UDim.new(0, 6)
                BtnCorner.Parent = Btn

                Btn.MouseButton1Click:Connect(function()
                    StealEgg(obj)
                end)
            end
        end
    end

    if foundCount == 0 then
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Scan Complete";
            Text = "Walang nahanap na Egg sa map.";
            Duration = 3;
        })
    end
end

RefreshBtn.MouseButton1Click:Connect(ScanEggs)

