-- Main Steal Engine: TP -> Wait -> Return Back
local function StealEgg(eggObject)
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = char:FindFirstChild("HumanoidRootPart")

    if not hrp then return end

    -- 1. Save Base position
    local originalCFrame = hrp.CFrame

    -- 2. Target Egg CFrame
    local targetCFrame
    if eggObject:IsA("BasePart") then
        targetCFrame = eggObject.CFrame
    elseif eggObject:IsA("Model") then
        targetCFrame = eggObject:GetPivot()
    end

    if targetCFrame then
        -- Teleport papunta sa Egg
        hrp.CFrame = targetCFrame + Vector3.new(0, 3, 0)
        
        -- Wait time para sa touch detection
        task.wait(0.3)

        -- Teleport pabalik sa Base pwesto
        hrp.CFrame = originalCFrame

        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Success!";
            Text = "Nakuha ang " .. eggObject.Name .. " at nakabalik sa pwesto!";
            Duration = 3;
        })
    end
end

-- Function para mag-scan ng Eggs
local function ScanEggs()
    for _, child in pairs(EggList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local foundCount = 0

    for _, obj in pairs(workspace:GetDescendants()) do
        if string.find(string.lower(obj.Name), "egg") then
            if obj:IsA("BasePart") or obj:IsA("Model") then
                foundCount = foundCount + 1

                local Btn = Instance.new("TextButton")
                Btn.Parent = EggList
                Btn.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
                Btn.Size = UDim2.new(0.95, 0, 0, 35)
                Btn.Font = Enum.Font.SourceSans
                Btn.Text = "🥚 " .. obj.Name
                Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                Btn.TextSize = 13.000

                local BtnCorner = Instance.new("UICorner")
                BtnCorner.CornerRadius = UDim.new(0, 6)
                BtnCorner.Parent = Btn

                Btn.MouseButton1Click:Connect(function()
                    StealEgg(obj)
                end)
            end
        end
    end

    if foundCount == 0 then
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Notice";
            Text = "Walang nahanap na Egg sa map.";
            Duration = 3;
        })
    end
end

ScanEggs()
RefreshBtn.MouseButton1Click:Connect(ScanEggs)
